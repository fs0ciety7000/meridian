# Runtime configuration (set as Coolify environment variables; never commit real values).
PORT=3000
LISTEN_HOST=::
STATIC_DIR=/app/public
DATA_DIR=/data
APP_VERSION=0.1.0
# Bearer token for GET /api/telemetry/summary (route disabled when unset).
# Generate with: openssl rand -base64 32 — store it as a Coolify secret only.
TELEMETRY_ADMIN_TOKEN=
# Phase 4 (API): JWT_SECRET, R2_* for Litestream — see docs/deployment.md
