{
  "$description": "Source of truth: docs/design-system.md. Generated into dist/tokens.css by scripts/build-css.ts.",
  "themes": {
    "atlas": {
      "paper-100": "#F7F1E5",
      "paper-200": "#F1E8D6",
      "paper-300": "#E6D9BF",
      "paper-400": "#D6C5A3",
      "sea-100": "#DCE5E0",
      "sea-200": "#C3D3CE",
      "sea-300": "#9DB5AF",
      "ink-900": "#24232B",
      "ink-700": "#45434F",
      "ink-500": "#6B6763",
      "sepia-600": "#6A513B",
      "vermilion-600": "#B5452B",
      "vermilion-700": "#93361F",
      "meridian-500": "#A27624",
      "rarity-known": "#7A5C3E",
      "rarity-trail": "#2F7A6B",
      "rarity-frontier": "#2C4A9A",
      "rarity-incognita": "#8E1F3A"
    },
    "nocturne": {
      "paper-100": "#141B22",
      "paper-200": "#1E2A33",
      "paper-300": "#26343F",
      "paper-400": "#33424E",
      "sea-100": "#0F161C",
      "sea-200": "#18232B",
      "sea-300": "#2E4550",
      "ink-900": "#E9E1CF",
      "ink-700": "#C7BEAB",
      "ink-500": "#9A927F",
      "sepia-600": "#9C8467",
      "vermilion-600": "#E2694B",
      "vermilion-700": "#C9573B",
      "meridian-500": "#D9AE55",
      "rarity-known": "#C29A6E",
      "rarity-trail": "#5FB3A1",
      "rarity-frontier": "#8EA6E8",
      "rarity-incognita": "#E07A93"
    }
  },
  "contrast": {
    "$description": "Pairs checked by test/contrast.test.ts on paper-100 (WCAG 2.1). 'text' = 4.5:1, 'graphic' = 3:1.",
    "text": [
      "ink-900",
      "ink-700",
      "ink-500",
      "sepia-600",
      "vermilion-600",
      "rarity-known",
      "rarity-trail",
      "rarity-frontier",
      "rarity-incognita"
    ],
    "graphic": ["meridian-500", "vermilion-700"]
  },
  "font": {
    "display": "'Fraunces Variable', Fraunces, 'Iowan Old Style', Georgia, serif",
    "map": "'EB Garamond', Garamond, 'Times New Roman', serif",
    "ui": "'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif",
    "mono": "'IBM Plex Mono', ui-monospace, monospace"
  },
  "type": {
    "display": {
      "size": "40px",
      "line": "44px"
    },
    "cartouche": {
      "size": "24px",
      "line": "30px"
    },
    "title": {
      "size": "20px",
      "line": "26px"
    },
    "body": {
      "size": "16px",
      "line": "24px"
    },
    "small": {
      "size": "14px",
      "line": "20px"
    },
    "label-caps": {
      "size": "12px",
      "line": "16px",
      "tracking": "0.14em"
    },
    "odometer": {
      "size": "28px",
      "line": "32px"
    },
    "coord": {
      "size": "12px",
      "line": "16px"
    }
  },
  "space": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px"
  },
  "radius": {
    "paper": "2px",
    "none": "0",
    "seal": "50%"
  },
  "shadow": {
    "paper": "0 1px 1px rgb(36 35 43 / 0.08), 0 6px 18px -6px rgb(36 35 43 / 0.18)",
    "emboss": "inset 0 1px 0 rgb(255 255 255 / 0.5), inset 0 -1px 0 rgb(0 0 0 / 0.06)"
  },
  "motion": {
    "ease": {
      "ink": "cubic-bezier(.22,.7,.18,1)",
      "stamp": "cubic-bezier(.5,0,.75,0)"
    },
    "duration": {
      "quick": 140,
      "paper": 320,
      "ink": 600,
      "routeMin": 900,
      "routeMax": 1600,
      "flight": 1500
    }
  },
  "map": {
    "coast": {
      "width": 0.9,
      "echoWidth": 0.4,
      "echoOffset": 1
    },
    "waterLines": {
      "offsets": [2, 5, 9],
      "opacity": [0.6, 0.35, 0.18],
      "width": 0.6,
      "opacityNocturne": [0.85, 0.5, 0.26]
    },
    "graticuleStepDeg": 15,
    "border": {
      "width": 0.6,
      "dash": [3, 1.5],
      "disputedDash": [1, 2]
    },
    "route": {
      "width": 2,
      "pastWidth": 1.5,
      "tickEveryKm": 500,
      "tickLength": 5,
      "crossingMarkerSize": 8
    },
    "unplantableHatch": {
      "color": "sepia-600",
      "opacity": 0.28,
      "angleDeg": 135,
      "spacing": 6,
      "width": 0.75
    },
    "meridian": {
      "width": 1.5,
      "tickEveryDeg": 10,
      "tickLength": 4,
      "label": {
        "color": "ink-700",
        "marker": "meridian-500",
        "markerSize": 6
      }
    },
    "label": {
      "minPx": 11,
      "maxPx": 15,
      "haloWidth": 3,
      "sea": {
        "atlas": {
          "color": "ink-700",
          "opacity": 0.8
        },
        "nocturne": {
          "color": "ink-500",
          "opacity": 0.85
        }
      }
    },
    "halo": {
      "sizePx": 22,
      "revealRadiusPx": 48
    },
    "hover": {
      "fill": "paper-300"
    },
    "projection": "equalEarth",
    "fit": {
      "marginRatio": 0.04,
      "minMapHeightRatioSm": 0.7
    }
  },
  "material": {
    "brass": {
      "stops": [
        ["#B08D57", 0],
        ["#E3C98F", 0.45],
        ["#8F6D3A", 1]
      ]
    },
    "brassInk": "#24232B"
  }
}
